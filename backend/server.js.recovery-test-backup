// ========================================
// WEBSOCKET SERVER
// ========================================

const wss = new WebSocket.Server({
    port: WEBSOCKET_PORT
});

function broadcast(message) {
    const data = JSON.stringify(message);

    wss.clients.forEach(client => {
        if (client.readyState === WebSocket.OPEN) {
            client.send(data);
        }
    });
}

wss.on("connection", socket => {
    console.log("WebSocket client connected");

    socket.send(JSON.stringify({
        type: "connection",
        message: "WebSocket connected"
    }));

    socket.on("close", () => {
        console.log("WebSocket client disconnected");
    });
});

console.log(
    `WebSocket server running on port ${WEBSOCKET_PORT}`
);


// ========================================
// URL VALIDATION
// ========================================

function isValidUrl(value) {
    try {
        const url = new URL(value);

        return (
            url.protocol === "http:" ||
            url.protocol === "https:"
        );
    } catch {
        return false;
    }
}



// ========================================
// RECOVER INTERRUPTED REELS SAFELY
// ========================================
//
// IMPORTANT:
//
// A Reel interrupted during Instagram publishing
// might already be live on Instagram.
//
// Never automatically retry an uncertain publish.
//
// Other interrupted processing jobs become failed.
// Queued jobs can resume normally.
//
// ========================================

function recoverInterruptedReels() {
    const reels = getReels();
    let changed = false;

    // Only these stages can safely restart from downloading.
    const restartableStatuses = [
        "downloading",
        "processing",
        "uploading",
        "interrupted"
    ];

    for (const reel of reels) {

        // Never modify confirmed published jobs.
        if (reel.status === "published") {
            continue;
        }

        // A saved publish marker means Instagram publishing
        // may have been attempted. Never retry automatically.
        if (
            reel.publishAttemptStarted === true ||
            reel.status === "publish_uncertain" ||
            reel.publishRecoveryRequired === true
        ) {
            reel.status = "publish_uncertain";
            reel.stage = "Publishing";
            reel.detail =
                "instagram_publish_result_uncertain_manual_check_required";
            reel.publishRecoveryRequired = true;

            if (!reel.lastError) {
                reel.lastError =
                    "Instagram publishing may have been attempted. " +
                    "Check Instagram before retrying.";
            }

            changed = true;

            console.warn(
                `[${reel.id}] Instagram publish result is uncertain. ` +
                "Automatic retry is blocked."
            );

            continue;
        }

        // A publishing status without the safety marker may
        // belong to an older version of SIFT. Treat it cautiously.
        if (reel.status === "publishing") {
            reel.status = "publish_uncertain";
            reel.stage = "Publishing";
            reel.detail =
                "server_stopped_during_instagram_publish_manual_check_required";
            reel.publishRecoveryRequired = true;
            reel.lastError =
                "The previous publishing state is ambiguous. " +
                "Check Instagram before retrying.";

            changed = true;

            console.warn(
                `[${reel.id}] Publishing state is ambiguous. ` +
                "Manual Instagram verification is required."
            );

            continue;
        }

        // Leave completed, queued, and already failed jobs alone.
        if (!restartableStatuses.includes(reel.status)) {
            continue;
        }

        console.log(
            `[${reel.id}] Interrupted Reel detected. ` +
            `Previous status: ${reel.status}, ` +
            `progress: ${reel.progress}%`
        );

        // Restart safely from the beginning of processing.
        reel.status = "queued";
        reel.stage = "Queued";
        reel.progress = 0;
        reel.detail =
            "restarting_from_download_after_server_restart";

        reel.lastError = null;

        console.log(
            `[${reel.id}] Reset to queued. ` +
            "Processing will restart from downloading."
        );

        changed = true;
    }

    // Persist recovery changes using the queue's atomic save.
    if (changed) {
        saveReels(reels);
        console.log("Interrupted Reel recovery changes saved.");
    } else {
        console.log("No Reel recovery changes were needed.");
    }
}


